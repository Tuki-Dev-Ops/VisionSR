# Normalise line endings. The repo stores LF; Windows checkouts get CRLF where it
# matters. Without this, a Windows contributor's first commit rewrites every file.
* text=auto eol=lf

# Shell scripts must keep LF even on Windows — CRLF makes the shebang unparseable and
# the script fails with a message ("bad interpreter") that names the wrong problem.
*.sh text eol=lf

# Binary. Never diff, never normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.onnx binary
*.pth binary

# Generated. Collapse in diffs and mark as not-authored for language statistics.
package-lock.json linguist-generated=true -diff
